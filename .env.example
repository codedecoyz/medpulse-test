# Supabase client configuration (safe for mobile bundle; protected by Postgres RLS)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# IMPORTANT (MP-NFR-001):
# Never place GEMINI_API_KEY in this file or any EXPO_PUBLIC_* variable.
# GEMINI_API_KEY must ONLY be configured in Supabase Edge Function secrets:
#   supabase secrets set GEMINI_API_KEY=...
